---
import { SITE } from '../site.config';

const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: '首页', match: (p: string) => p === '/' },
  { href: '/papers', label: '推断智能', match: (p: string) => p.startsWith('/papers') },
  { href: '/blog', label: '随笔', match: (p: string) => p.startsWith('/blog') },
  { href: '/projects', label: '项目', match: (p: string) => p.startsWith('/projects') },
  { href: '/about', label: '关于', match: (p: string) => p.startsWith('/about') },
];
---

<header
  class="site-navbar sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6">
    <!-- Brand -->
    <a
      href="/"
      class="group flex items-center gap-2.5 text-[var(--text)] transition-colors hover:text-[var(--accent)]"
    >
      <img
        src={SITE.avatar}
        alt={SITE.author}
        width="28"
        height="28"
        class="h-7 w-7 rounded-full border border-[var(--border-strong)] object-cover transition-transform duration-200 group-hover:scale-105"
      />
      <span class="font-mono text-sm font-semibold tracking-tight">anka</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {
        navItems.map((item) => {
          const active = item.match(pathname);
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
                active
                  ? 'bg-[var(--surface-soft)] text-[var(--accent)]'
                  : 'text-[var(--text-secondary)] hover:bg-[var(--surface-soft)]/60 hover:text-[var(--text)]',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-1.5">
      <button
        id="search-trigger"
        type="button"
        aria-label="搜索文章和项目"
        class="flex h-9 items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--surface)] px-2.5 text-xs text-[var(--text-muted)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text)]"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden sm:inline">搜索</span>
        <kbd
          class="hidden rounded bg-[var(--surface-soft)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--accent)] sm:inline"
        >
          Ctrl K
        </kbd>
      </button>

      <button
        id="theme-toggle"
        type="button"
        aria-label="切换深浅色主题"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--surface)] text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--accent)]"
      >
        <!-- Sun (shown in dark mode) -->
        <svg
          class="hidden h-4 w-4 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Moon (shown in light mode) -->
        <svg
          class="block h-4 w-4 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="打开菜单"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--surface)] text-[var(--text-secondary)] md:hidden"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav Dropdown -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-[var(--border)] bg-[var(--surface)] px-4 py-3 md:hidden"
    aria-label="移动端导航"
  >
    <div class="flex flex-col gap-1">
      {
        navItems.map((item) => {
          const active = item.match(pathname);
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                active
                  ? 'bg-[var(--surface-soft)] text-[var(--accent)]'
                  : 'text-[var(--text-secondary)] hover:bg-[var(--surface-soft)]/50',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    function initNavbar() {
      const toggle = document.getElementById('theme-toggle');
      if (toggle && toggle.dataset.bound !== '1') {
        toggle.dataset.bound = '1';
        toggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          const nextTheme = isDark ? 'dark' : 'light';
          localStorage.setItem('anka-theme', nextTheme);
          window.dispatchEvent(new CustomEvent('anka-theme-change', { detail: { theme: nextTheme } }));
        });
      }

      const mobileBtn = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      if (mobileBtn && mobileMenu && mobileBtn.dataset.bound !== '1') {
        mobileBtn.dataset.bound = '1';
        mobileBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }
    }

    if (!window.__ankaNavbarBound) {
      window.__ankaNavbarBound = true;
      document.addEventListener('astro:page-load', initNavbar);
    }
    initNavbar();
  })();
</script>
