---
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
  mode?: 'desktop' | 'mobile';
}

const { headings, mode = 'desktop' } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  tocHeadings.length > 0 && mode === 'mobile' && (
    <details class="zen-hide mb-8 rounded-xl border border-[var(--border)] bg-[var(--surface)]/70 px-4 py-3 lg:hidden">
      <summary class="cursor-pointer select-none font-mono text-xs font-semibold text-[var(--text-secondary)]">
        目录大纲（{tocHeadings.length} 节）
      </summary>
      <nav aria-label="移动端文章目录" class="mt-3 border-t border-[var(--border)] pt-2.5">
        <ul class="space-y-1 text-xs">
          {tocHeadings.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class:list={[
                  'block py-1 text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]',
                  h.depth === 3 ? 'pl-4' : 'font-medium',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}

{
  tocHeadings.length > 0 && mode === 'desktop' && (
    <aside class="zen-hide hidden lg:block">
      <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pr-2">
        <div class="mb-3 flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-wider text-[var(--text-muted)]">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--accent)]" />
          目录大纲
        </div>
        <nav aria-label="文章目录" class="border-l border-[var(--border)]">
          <ul class="space-y-1 text-[13px]">
            {tocHeadings.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  data-toc-link={h.slug}
                  data-toc-desktop="true"
                  class:list={[
                    'toc-link block border-l-2 border-transparent py-1 pr-2 leading-snug text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]',
                    h.depth === 2 ? 'pl-3 font-medium' : 'pl-6 text-xs',
                  ]}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="mt-6 space-y-2.5 border-t border-[var(--border)] pt-4">
          <button
            type="button"
            data-formula-sheet-trigger
            class="hidden w-full cursor-pointer items-center justify-between rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 py-2 text-left font-mono text-[11px] font-medium text-[var(--text-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--accent)]"
          >
            <span>全篇公式速览</span>
            <span data-formula-count class="text-[var(--accent)]">0</span>
          </button>

          <p class="text-[11px] leading-relaxed text-[var(--text-muted)]">
            <span class="font-mono font-semibold text-[var(--accent)]">Tip:</span> 点击任意公式复制 LaTeX（<code class="text-[var(--text-secondary)]">Shift</code>+点击纯源码 · <code class="text-[var(--text-secondary)]">z</code> 沉浸模式）。
          </p>
        </div>
      </div>
    </aside>
  )
}

{
  tocHeadings.length > 0 && mode === 'desktop' && (
    <script is:inline>
      (() => {
        let activeObserver = null;

        function initToc() {
          if (activeObserver) {
            activeObserver.disconnect();
            activeObserver = null;
          }

          const allLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
          if (!allLinks.length) return;

          allLinks.forEach((link) => {
            const slug = link.getAttribute('data-toc-link');
            const el = slug ? document.getElementById(slug) : null;
            if (el && el.querySelector('.katex')) {
              const clone = el.cloneNode(true);
              clone.querySelectorAll('.katex-mathml, .heading-anchor-btn').forEach((n) => n.remove());
              link.innerHTML = clone.innerHTML;
            }
          });

          const desktopLinks = Array.from(document.querySelectorAll('[data-toc-desktop="true"]'));
          if (!desktopLinks.length) return;

          const headingMap = desktopLinks
            .map((link) => {
              const slug = link.getAttribute('data-toc-link');
              const el = slug ? document.getElementById(slug) : null;
              return el ? { link, el } : null;
            })
            .filter(Boolean);

          if (!headingMap.length) return;

          function setActive(activeSlug) {
            for (const { link, el } of headingMap) {
              const isCurrent = el.id === activeSlug;
              link.classList.toggle('border-[var(--accent)]', isCurrent);
              link.classList.toggle('text-[var(--accent)]', isCurrent);
              link.classList.toggle('border-transparent', !isCurrent);
              link.classList.toggle('text-[var(--text-muted)]', !isCurrent);
            }
          }

          activeObserver = new IntersectionObserver(
            (entries) => {
              const visible = entries.filter((e) => e.isIntersecting);
              if (visible.length > 0) {
                setActive(visible[0].target.id);
              }
            },
            { rootMargin: '-88px 0px -70% 0px', threshold: 0 }
          );

          headingMap.forEach(({ el }) => activeObserver.observe(el));
          setActive(headingMap[0].el.id);
        }

        if (!window.__ankaTocBound) {
          window.__ankaTocBound = true;
          document.addEventListener('astro:page-load', initToc);
          document.addEventListener('astro:before-swap', () => {
            if (activeObserver) {
              activeObserver.disconnect();
              activeObserver = null;
            }
          });
        }
        initToc();
      })();
    </script>
  )
}
