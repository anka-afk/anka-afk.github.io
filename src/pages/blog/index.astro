---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { estimateReadingMinutes, formatDate } from '../../utils/format';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags)));
const showTagFilter = posts.length >= 6 && allTags.length > 1;
---

<BaseLayout title="随笔" description="技术笔记、工程折腾记录与阶段性思考">
  <header class="border-b border-[var(--border)] pb-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text)]">随笔</h1>
    <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-[var(--text-secondary)]">
      论文专栏之外的技术笔记、工程折腾与阶段性思考。
    </p>

    {
      showTagFilter && (
        <div class="mt-5 flex flex-wrap gap-2">
          <button
            type="button"
            data-tag="__all__"
            class="blog-tag-btn rounded-full bg-[var(--accent)] px-3 py-1 text-xs font-semibold text-[var(--bg)] transition-colors"
          >
            全部 ({posts.length})
          </button>
          {allTags.map((tag) => (
            <button
              type="button"
              data-tag={tag}
              class="blog-tag-btn rounded-full bg-[var(--surface-soft)] px-3 py-1 text-xs font-medium text-[var(--accent)] transition-colors hover:bg-[var(--surface-hover)]"
            >
              #{tag}
            </button>
          ))}
        </div>
      )
    }
  </header>

  <section class="divide-y divide-[var(--border)]">
    {
      posts.length === 0 ? (
        <p class="py-16 text-center text-sm text-[var(--text-muted)]">暂无随笔。</p>
      ) : (
        posts.map((post) => {
          const mins = estimateReadingMinutes(post.body || '');
          return (
            <a
              href={`/blog/${post.id}`}
              data-tags={post.data.tags.join('|')}
              class="blog-item group -mx-3 block rounded-xl px-3 py-6 transition-colors hover:bg-[var(--surface-soft)]/35"
            >
              <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-[var(--text-muted)]">
                <time>{formatDate(post.data.publishedAt)}</time>
                <span>·</span>
                <span>约 {mins} 分钟</span>
              </div>

              <h2 class="mt-1.5 text-lg font-bold text-[var(--text)] transition-colors group-hover:text-[var(--accent)] sm:text-xl">
                {post.data.title}
              </h2>

              <p class="mt-1.5 max-w-3xl text-sm leading-relaxed text-[var(--text-secondary)]">
                {post.data.description}
              </p>

              {post.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-[var(--text-muted)]">
                  {post.data.tags.map((tag) => (
                    <span>#{tag}</span>
                  ))}
                </div>
              )}
            </a>
          );
        })
      )
    }
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const buttons = Array.from(document.querySelectorAll('.blog-tag-btn'));
    const items = Array.from(document.querySelectorAll('.blog-item'));
    if (!buttons.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-tag') || '__all__';
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('bg-[var(--accent)]', active);
          b.classList.toggle('text-[var(--bg)]', active);
          b.classList.toggle('font-semibold', active);
          b.classList.toggle('bg-[var(--surface-soft)]', !active);
          b.classList.toggle('text-[var(--accent)]', !active);
        });
        items.forEach((el) => {
          const tags = (el.getAttribute('data-tags') || '').split('|');
          el.classList.toggle('hidden', selected !== '__all__' && !tags.includes(selected));
        });
      });
    });
  })();
</script>
