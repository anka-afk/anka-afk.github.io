---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingEnhancements from '../../components/ReadingEnhancements.astro';
import Giscus from '../../components/Giscus.astro';
import { SITE } from '../../site.config';
import { formatDate } from '../../utils/format';
import { buildCleanMarkdown, buildPaperBibtex } from '../../utils/markdown';

export async function getStaticPaths() {
  const papers = (await getCollection('papers')).sort((a, b) => a.data.order - b.data.order);
  return papers.map((paper, idx) => ({
    params: { id: paper.id },
    props: {
      paper,
      allPapers: papers,
      prevPaper: idx > 0 ? papers[idx - 1] : null,
      nextPaper: idx < papers.length - 1 ? papers[idx + 1] : null,
    },
  }));
}

function inferConceptKeywords(id: string, title: string): string[] {
  const slugKey = id.replace(/^\d+-/, '').trim();
  const knownMap: Record<string, string[]> = {
    dpo: ['DPO'],
    score: ['SCoRe'],
    mamba: ['Mamba'],
    eto: ['ETO'],
    nlhf: ['NLHF'],
  };
  if (knownMap[slugKey.toLowerCase()]) return knownMap[slugKey.toLowerCase()];

  // Fallback: extract explicit acronym from title or uppercase short slug
  const acro = title.match(/\b[A-Z][A-Za-z0-9]{1,7}\b/);
  if (acro && acro[0].length >= 2) return [acro[0]];
  if (/^[a-z]{2,6}$/i.test(slugKey)) return [slugKey.toUpperCase()];
  return [];
}

const { paper, allPapers, prevPaper, nextPaper } = Astro.props;
const { Content, headings } = await render(paper);

const otherPaperRefs = allPapers
  .filter((p) => p.id !== paper.id)
  .map((p) => ({
    keywords: inferConceptKeywords(p.id, p.data.title),
    number: p.data.number,
    title: p.data.displayTitle,
    venue: p.data.venue ? p.data.venue.split('（')[0] : '',
    summary: p.data.summary,
    url: `/papers/${p.id}`,
  }))
  .filter((r) => r.keywords.length > 0);
const safeRefsJson = JSON.stringify(otherPaperRefs).replace(/<\/script/gi, '<\\/script');

const pageUrl = `${SITE.url}/papers/${paper.id}`;
const cleanMarkdown = buildCleanMarkdown(paper.body || '', {
  title: paper.data.title,
  url: pageUrl,
  summary: paper.data.summary,
  paperUrl: paper.data.paperUrl,
  codeUrl: paper.data.codeUrl,
  venue: paper.data.venue,
  isPaper: true,
});
const safeMarkdownJson = JSON.stringify(cleanMarkdown).replace(/<\/script/gi, '<\\/script');

const attributionText = `本文整理自 ${SITE.author} 的《${SITE.series.name}》专栏：[${paper.data.displayTitle}](${pageUrl})，原文采用 [CC BY 4.0](https://creativecommons.org/licenses/by/4.0/) 许可协议。`;
const bibtexText = buildPaperBibtex({
  slug: paper.id,
  title: paper.data.title,
  paperUrl: paper.data.paperUrl,
  venue: paper.data.venue,
});
---

<BaseLayout
  title={`${paper.data.displayTitle} · 推断智能`}
  description={paper.data.summary}
  image={`/og/${paper.id}.svg`}
  article={true}
>
  <!-- Compact Breadcrumb -->
  <nav class="zen-hide mb-5 flex items-center gap-2 font-mono text-xs text-[var(--text-muted)]">
    <a href="/" class="hover:text-[var(--accent)]">首页</a>
    <span>/</span>
    <a href="/papers" class="hover:text-[var(--accent)]">推断智能</a>
    <span>/</span>
    <span class="text-[var(--accent)]">#{paper.data.number}</span>
  </nav>

  <!-- Slim, Borderless Academic Paper Header -->
  <header class="mb-9 border-b border-[var(--border)] pb-7">
    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs text-[var(--text-muted)]">
      <span
        data-arxiv-trigger
        class="cursor-pointer font-semibold text-[var(--accent)] select-none"
      >
        推断智能 #{paper.data.number}
      </span>
      {
        paper.data.venue && (
          <>
            <span>·</span>
            <span class="text-[var(--text-secondary)]">{paper.data.venue}</span>
          </>
        )
      }
      <span>·</span>
      <span>约 {paper.data.readingMinutes} 分钟</span>
      {
        paper.data.formulaCount > 0 && (
          <>
            <span>·</span>
            <span>{paper.data.formulaCount} 块公式</span>
          </>
        )
      }
      <span>·</span>
      <time>更新于 {formatDate(paper.data.updatedAt)}</time>
    </div>

    <h1 class="mt-3 max-w-4xl text-2xl font-extrabold leading-tight tracking-tight text-[var(--text)] sm:text-3xl">
      {paper.data.title}
    </h1>

    <!-- Lightweight Left-Border TL;DR -->
    <p class="mt-4 max-w-3xl border-l-2 border-[var(--accent)] pl-4 text-sm leading-relaxed text-[var(--text-secondary)]">
      <span class="mr-1.5 font-mono text-xs font-semibold text-[var(--accent)]">TL;DR</span>
      {paper.data.summary}
    </p>

    <!-- Text Action Links + Muted Topics -->
    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 font-mono">
        {
          paper.data.paperUrl && (
            <a
              href={paper.data.paperUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-[var(--accent)] hover:underline"
            >
              arXiv 原文 ↗
            </a>
          )
        }
        {
          paper.data.codeUrl && (
            <a
              href={paper.data.codeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
            >
              官方代码 ↗
            </a>
          )
        }
        {
          paper.data.courseUrl && (
            <a
              href={paper.data.courseUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
            >
              配套视频 ↗
            </a>
          )
        }
        {
          paper.data.sourceUrl && (
            <a
              href={paper.data.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
            >
              GitHub 手稿 ↗
            </a>
          )
        }
        <button
          type="button"
          data-copy-markdown
          class="cursor-pointer text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
        >
          复制 Markdown
        </button>
        <button
          type="button"
          data-zen-toggle
          class="zen-hide cursor-pointer text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
          title="沉浸阅读模式（快捷键 z）"
        >
          沉浸阅读
        </button>
        <span class="lg:hidden">
          <button
            type="button"
            data-formula-sheet-trigger
            class="hidden cursor-pointer items-center gap-1 text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
          >
            <span>公式速览</span>
            <span data-formula-count class="text-[var(--accent)]"></span>
          </button>
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[var(--text-muted)]">
        {paper.data.topics.map((topic) => <span>#{topic}</span>)}
      </div>
    </div>
  </header>

  <!-- Responsive Two-Column Layout (Desktop >= 1024px shows Sticky TOC) -->
  <div class="zen-reading-grid grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_210px]">
    <div class="zen-reading-col mx-auto w-full max-w-3xl min-w-0 lg:mx-0 lg:max-w-none">
      <!-- Mobile TOC (< 1024px) -->
      <TableOfContents headings={headings} mode="mobile" />

      <article class="prose-anka">
        <Content />
      </article>

      <!-- Clean CC BY 4.0 Attribution & Citation Footer -->
      <div class="mt-12 border-t border-[var(--border)] pt-6 text-xs leading-relaxed text-[var(--text-muted)]">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="font-semibold text-[var(--text-secondary)]">版权与引用（CC BY 4.0）</span>
          <div class="flex flex-wrap items-center gap-4 font-mono">
            <button
              type="button"
              data-copy-text={attributionText}
              data-copy-toast="已复制 CC BY 4.0 转载署名"
              class="cursor-pointer text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
            >
              复制转载署名
            </button>
            {
              paper.data.paperUrl && (
                <button
                  type="button"
                  data-copy-text={bibtexText}
                  data-copy-toast="已复制论文 BibTeX"
                  class="cursor-pointer text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
                >
                  复制 BibTeX
                </button>
              )
            }
            <a
              href={paper.data.sourceUrl || SITE.social.inferringRepo}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--accent)] hover:underline"
            >
              提出勘误 ↗
            </a>
          </div>
        </div>
        <p class="mt-1.5">
          本文同步自《推断智能》仓库，原创手稿采用{' '}
          <a
            href="https://creativecommons.org/licenses/by/4.0/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--accent)] underline"
          >
            CC BY 4.0
          </a>{' '}
          许可。转载须标明作者（{SITE.author}）与出处并附原文链接；论文原图与引用内容版权归原作者所有。
        </p>
      </div>

      <!-- Prev / Next Navigation -->
      <nav class="mt-8 grid grid-cols-1 gap-4 border-t border-[var(--border)] pt-6 sm:grid-cols-2" aria-label="上下篇导航">
        {
          prevPaper ? (
            <a href={`/papers/${prevPaper.id}`} data-nav-prev class="group flex flex-col">
              <span class="font-mono text-[11px] text-[var(--text-muted)]">
                ← 上一篇 · #{prevPaper.data.number}
              </span>
              <span class="mt-1 line-clamp-1 text-sm font-semibold text-[var(--text)] transition-colors group-hover:text-[var(--accent)]">
                {prevPaper.data.displayTitle}
              </span>
            </a>
          ) : (
            <div />
          )
        }
        {
          nextPaper && (
            <a href={`/papers/${nextPaper.id}`} data-nav-next class="group flex flex-col sm:text-right">
              <span class="font-mono text-[11px] text-[var(--text-muted)]">
                下一篇 · #{nextPaper.data.number} →
              </span>
              <span class="mt-1 line-clamp-1 text-sm font-semibold text-[var(--text)] transition-colors group-hover:text-[var(--accent)]">
                {nextPaper.data.displayTitle}
              </span>
            </a>
          )
        }
      </nav>

      <Giscus />
    </div>

    <TableOfContents headings={headings} mode="desktop" />
  </div>

  <script id="anka-raw-markdown" type="application/json" set:html={safeMarkdownJson} />
  <script id="anka-paper-refs" type="application/json" set:html={safeRefsJson} />
  <ReadingEnhancements />
</BaseLayout>
