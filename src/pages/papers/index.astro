---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperGraph from '../../components/PaperGraph.astro';
import { SITE } from '../../site.config';
import { formatDate } from '../../utils/format';

const papers = (await getCollection('papers')).sort((a, b) => a.data.order - b.data.order);
const allTopics = Array.from(new Set(papers.flatMap((p) => p.data.topics)));
const showTopicFilter = papers.length >= 10 && allTopics.length > 1;
---

<BaseLayout title={`《${SITE.series.name}》`} description={SITE.series.description}>
  <!-- Clean Borderless Series Header -->
  <header class="border-b border-[var(--border)] pb-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-baseline gap-3">
        <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text)]">
          《{SITE.series.name}》
        </h1>
        <span class="font-mono text-xs text-[var(--text-muted)]">
          {SITE.series.enName} · {papers.length} 篇
        </span>
      </div>

      <div class="flex items-center gap-4">
        <!-- View Switcher: List | Knowledge Graph -->
        <div
          id="papers-view-switch"
          class="inline-flex rounded-lg border border-[var(--border)] bg-[var(--surface)] p-0.5 font-mono text-xs"
          role="group"
          aria-label="视图切换"
        >
          <button
            type="button"
            data-papers-view="list"
            class="cursor-pointer rounded-md bg-[var(--surface-soft)] px-2.5 py-1 font-semibold text-[var(--accent)] transition-colors"
          >
            列表
          </button>
          <button
            type="button"
            data-papers-view="graph"
            class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[var(--text-muted)] transition-colors hover:text-[var(--text)]"
          >
            图谱
          </button>
        </div>

        <a
          href={SITE.social.inferringRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
        >
          手稿仓库 ↗
        </a>
      </div>
    </div>

    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--text-secondary)]">
      {SITE.series.tagline}
    </p>

    {
      showTopicFilter && (
        <div class="mt-5 flex flex-wrap items-center gap-2" id="topic-filters">
          <button
            type="button"
            data-topic="__all__"
            class="topic-btn rounded-full bg-[var(--accent)] px-3 py-1 text-xs font-semibold text-[var(--bg)] transition-colors"
          >
            全部 ({papers.length})
          </button>
          {allTopics.map((topic) => (
            <button
              type="button"
              data-topic={topic}
              class="topic-btn rounded-full bg-[var(--surface-soft)] px-3 py-1 text-xs font-medium text-[var(--accent)] transition-colors hover:bg-[var(--surface-hover)]"
            >
              {topic}
            </button>
          ))}
        </div>
      )
    }
  </header>

  <!-- Interactive Knowledge Graph View -->
  <PaperGraph papers={papers} />

  <!-- Airy Hairline-Divided Paper List -->
  <section class="divide-y divide-[var(--border)]" id="papers-list">
    {
      papers.map((paper) => (
        <article
          class="paper-item group py-7"
          data-topics={paper.data.topics.join('|')}
        >
          <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs text-[var(--text-muted)]">
            <span class="font-semibold text-[var(--accent)]">#{paper.data.number}</span>
            {paper.data.venue && (
              <>
                <span>·</span>
                <span class="text-[var(--text-secondary)]">{paper.data.venue}</span>
              </>
            )}
            <span>·</span>
            <span>约 {paper.data.readingMinutes} 分钟</span>
            {paper.data.formulaCount > 0 && (
              <>
                <span>·</span>
                <span>{paper.data.formulaCount} 块公式</span>
              </>
            )}
            <span>·</span>
            <time>{formatDate(paper.data.updatedAt)}</time>
          </div>

          <a href={`/papers/${paper.id}`} class="mt-2 block">
            <h2 class="text-lg font-extrabold tracking-tight text-[var(--text)] transition-colors group-hover:text-[var(--accent)] sm:text-xl">
              {paper.data.displayTitle}
            </h2>
          </a>

          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-[var(--text-secondary)]">
            {paper.data.summary}
          </p>

          <div class="mt-3.5 flex flex-wrap items-center justify-between gap-3 text-xs">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[var(--text-muted)]">
              {paper.data.topics.map((topic) => (
                <span>#{topic}</span>
              ))}
            </div>

            <div class="flex flex-wrap items-center gap-4 font-mono">
              <a
                href={`/papers/${paper.id}`}
                class="font-semibold text-[var(--accent)] hover:underline"
              >
                阅读精读 →
              </a>
              {paper.data.paperUrl && (
                <a
                  href={paper.data.paperUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
                >
                  arXiv ↗
                </a>
              )}
              {paper.data.codeUrl && (
                <a
                  href={paper.data.codeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
                >
                  Code ↗
                </a>
              )}
              {paper.data.courseUrl && (
                <a
                  href={paper.data.courseUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--text-muted)] transition-colors hover:text-[var(--accent)]"
                >
                  视频 ↗
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    function initPapersPage() {
      const switchWrap = document.getElementById('papers-view-switch');
      const listEl = document.getElementById('papers-list');
      const graphEl = document.getElementById('paper-graph-view');
      if (switchWrap && listEl && graphEl && switchWrap.dataset.bound !== '1') {
        switchWrap.dataset.bound = '1';
        const viewBtns = Array.from(switchWrap.querySelectorAll('[data-papers-view]'));
        viewBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const view = btn.getAttribute('data-papers-view') || 'list';
            const isGraph = view === 'graph';
            listEl.classList.toggle('hidden', isGraph);
            graphEl.classList.toggle('hidden', !isGraph);
            viewBtns.forEach((b) => {
              const active = b === btn;
              b.classList.toggle('bg-[var(--surface-soft)]', active);
              b.classList.toggle('text-[var(--accent)]', active);
              b.classList.toggle('font-semibold', active);
              b.classList.toggle('text-[var(--text-muted)]', !active);
            });
          });
        });
      }

      const buttons = Array.from(document.querySelectorAll('.topic-btn'));
      const cards = Array.from(document.querySelectorAll('.paper-item'));
      buttons.forEach((btn) => {
        if (btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const selected = btn.getAttribute('data-topic') || '__all__';
          buttons.forEach((b) => {
            const isActive = b === btn;
            b.classList.toggle('bg-[var(--accent)]', isActive);
            b.classList.toggle('text-[var(--bg)]', isActive);
            b.classList.toggle('font-semibold', isActive);
            b.classList.toggle('bg-[var(--surface-soft)]', !isActive);
            b.classList.toggle('text-[var(--accent)]', !isActive);
          });
          cards.forEach((card) => {
            const topics = (card.getAttribute('data-topics') || '').split('|');
            card.classList.toggle('hidden', selected !== '__all__' && !topics.includes(selected));
          });
        });
      });
    }

    if (!window.__ankaPapersPageBound) {
      window.__ankaPapersPageBound = true;
      document.addEventListener('astro:page-load', initPapersPage);
    }
    initPapersPage();
  })();
</script>
